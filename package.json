{
    "name": "offline-reader-pc",
    "version": "1.0.0",
    "description": "轻量本地离线阅读器（仅 TXT，无联网书城）",
    "private": true,
    "license": "MIT",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "build:render": "vue-tsc --noEmit && vite build",
        "build": "npm run build:render",
        "build:win": "npm run build:render && node builder.cjs --win32=x64",
        "build:win:ia32": "npm run build:render && node builder.cjs --win32=ia32",
        "preview": "vite preview"
    },
    "dependencies": {
        "iconv-lite": "^0.6.3",
        "jschardet": "^3.1.4",
        "nanoid": "^5.0.7",
        "pinia": "^2.2.4",
        "vue": "^3.5.11",
        "vue-router": "^4.4.5"
    },
    "devDependencies": {
        "@types/node": "^22.7.4",
        "@vitejs/plugin-vue": "^5.1.4",
        "electron": "^31.6.0",
        "electron-builder": "^24.13.3",
        "sass": "^1.79.4",
        "typescript": "^5.6.2",
        "vite": "^5.4.8",
        "vite-plugin-electron": "^0.28.8",
        "vite-plugin-electron-renderer": "^0.14.6",
        "vue-tsc": "^2.1.6"
    }
}